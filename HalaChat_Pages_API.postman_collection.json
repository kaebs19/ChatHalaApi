{
	"info": {
		"_postman_id": "halachat-pages-api",
		"name": "HalaChat - App Pages API",
		"description": "API endpoints for HalaChat app pages (Privacy Policy, Terms, About, Contact Us)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5001/api",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Public Pages (No Auth Required)",
			"item": [
				{
					"name": "Get Privacy Policy",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/settings/privacy-policy",
							"host": ["{{baseUrl}}"],
							"path": ["settings", "privacy-policy"]
						},
						"description": "Get privacy policy content - Public access"
					},
					"response": []
				},
				{
					"name": "Get Terms of Service",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/settings/terms",
							"host": ["{{baseUrl}}"],
							"path": ["settings", "terms"]
						},
						"description": "Get terms of service content - Public access"
					},
					"response": []
				},
				{
					"name": "Get About App",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/settings/about",
							"host": ["{{baseUrl}}"],
							"path": ["settings", "about"]
						},
						"description": "Get about app content with app name and version - Public access"
					},
					"response": []
				},
				{
					"name": "Get Contact Us",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/settings/contact-us",
							"host": ["{{baseUrl}}"],
							"path": ["settings", "contact-us"]
						},
						"description": "Get contact us page with email, phone, website and social media - Public access"
					},
					"response": []
				},
				{
					"name": "Get All Settings (Public)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/settings",
							"host": ["{{baseUrl}}"],
							"path": ["settings"]
						},
						"description": "Get all public settings - Returns limited data for non-admin users"
					},
					"response": []
				}
			]
		},
		{
			"name": "Admin Pages (Auth Required)",
			"item": [
				{
					"name": "Update Privacy Policy",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"content\": \"# سياسة الخصوصية\\n\\nمرحباً بك في HalaChat. نحن نحترم خصوصيتك ونلتزم بحماية بياناتك الشخصية.\\n\\n## جمع البيانات\\nنقوم بجمع البيانات التالية:\\n- الاسم والبريد الإلكتروني\\n- معلومات الملف الشخصي\\n- سجل المحادثات\\n\\n## استخدام البيانات\\nنستخدم بياناتك لـ:\\n- تقديم خدمة المحادثة\\n- تحسين تجربة المستخدم\\n- إرسال الإشعارات المهمة\\n\\n## حماية البيانات\\nنحن نستخدم أحدث تقنيات التشفير لحماية بياناتك.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/settings/content/privacy",
							"host": ["{{baseUrl}}"],
							"path": ["settings", "content", "privacy"]
						},
						"description": "Update privacy policy content - Admin only"
					},
					"response": []
				},
				{
					"name": "Update Terms of Service",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"content\": \"# شروط الاستخدام\\n\\nبإستخدامك لتطبيق HalaChat، فإنك توافق على الشروط التالية:\\n\\n## القبول\\n- يجب أن يكون عمرك 13 سنة على الأقل\\n- يجب تقديم معلومات صحيحة عند التسجيل\\n\\n## السلوك المقبول\\n- احترام الآخرين\\n- عدم نشر محتوى مسيء\\n- عدم انتهاك حقوق الملكية الفكرية\\n\\n## الحساب\\n- أنت مسؤول عن أمان حسابك\\n- لا تشارك كلمة المرور مع أحد\\n\\n## الإنهاء\\nيحق لنا إنهاء حسابك في حالة انتهاك هذه الشروط.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/settings/content/terms",
							"host": ["{{baseUrl}}"],
							"path": ["settings", "content", "terms"]
						},
						"description": "Update terms of service content - Admin only"
					},
					"response": []
				},
				{
					"name": "Update About App",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"content\": \"# حول HalaChat\\n\\nHalaChat هو تطبيق محادثة فوري يوفر تجربة تواصل سلسة وآمنة.\\n\\n## المميزات\\n- محادثات فردية وجماعية\\n- مشاركة الصور والملفات\\n- إشعارات فورية\\n- تشفير كامل للمحادثات\\n\\n## رؤيتنا\\nنسعى لتوفير أفضل تجربة محادثة للمستخدمين العرب.\\n\\n## فريق العمل\\nتم تطوير HalaChat بواسطة فريق متخصص من المطورين العرب.\\n\\n## الإصدار\\nالإصدار الحالي: 1.0.0\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/settings/content/about",
							"host": ["{{baseUrl}}"],
							"path": ["settings", "content", "about"]
						},
						"description": "Update about app content - Admin only"
					},
					"response": []
				},
				{
					"name": "Update Contact Us",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"content\": \"# اتصل بنا\\n\\nنحن سعداء بتواصلك معنا! فريق الدعم متاح لمساعدتك.\\n\\n## طرق التواصل\\n\\n### البريد الإلكتروني\\nsupport@halachat.com\\n\\n### الهاتف\\n+966 xx xxx xxxx\\n\\n### ساعات العمل\\nالأحد - الخميس: 9 صباحاً - 6 مساءً\\n\\n## الدعم الفني\\nللمشاكل التقنية، يرجى إرسال بريد إلى:\\ntech@halachat.com\\n\\n## تابعنا على وسائل التواصل\\n- تويتر: @HalaChat\\n- انستجرام: @HalaChatApp\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/settings/content/contact",
							"host": ["{{baseUrl}}"],
							"path": ["settings", "content", "contact"]
						},
						"description": "Update contact us content - Admin only"
					},
					"response": []
				},
				{
					"name": "Update All Settings",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"appName\": \"HalaChat\",\n    \"appVersion\": \"1.0.0\",\n    \"contactEmail\": \"support@halachat.com\",\n    \"contactPhone\": \"+966xxxxxxxxx\",\n    \"websiteUrl\": \"https://halachat.com\",\n    \"socialMedia\": {\n        \"facebook\": \"https://facebook.com/halachat\",\n        \"twitter\": \"https://twitter.com/halachat\",\n        \"instagram\": \"https://instagram.com/halachat\"\n    }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/settings",
							"host": ["{{baseUrl}}"],
							"path": ["settings"]
						},
						"description": "Update all settings at once - Admin only"
					},
					"response": []
				}
			]
		},
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login (Get Token)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.success && jsonData.data.token) {",
									"    pm.collectionVariables.set('token', jsonData.data.token);",
									"    console.log('Token saved successfully!');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@halachat.com\",\n    \"password\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						},
						"description": "Login to get JWT token - Token will be automatically saved to collection variable"
					},
					"response": []
				}
			]
		}
	]
}
