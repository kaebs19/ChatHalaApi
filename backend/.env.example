# Database
MONGODB_URI=mongodb://localhost:27017/halachat

# JWT - يجب تغيير هذا السر! استخدم: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_CRYPTO_RANDOM_64_BYTES
JWT_ACCESS_EXPIRE=1d
JWT_REFRESH_SECRET=CHANGE_ME_USE_DIFFERENT_CRYPTO_RANDOM
JWT_REFRESH_EXPIRE=30d

# Server
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BASE_URL=http://localhost:5001
ALLOWED_ORIGINS=http://localhost:3001

# APNS (Apple Push Notifications)
APNS_KEY_ID=your_key_id
APNS_TEAM_ID=your_team_id
APNS_KEY_PATH=./config/AuthKey.p8
APNS_BUNDLE_ID=com.your.app.bundle

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Apple Sign In
APPLE_CLIENT_ID=com.your.app.bundle
APPLE_TEAM_ID=your_team_id

# Email (Gmail - استخدم App Password وليس كلمة المرور العادية)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM_NAME=HalaChat
