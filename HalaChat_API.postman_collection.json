{
	"info": {
		"_postman_id": "halachat-api-collection",
		"name": "HalaChat Mobile API",
		"description": "API للتطبيق - تسجيل الدخول، المحادثات، الرسائل، الإشعارات",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "https://halachat.khalafiati.io/api",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Google Sign In",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"idToken\": \"google_id_token_here\",\n    \"deviceToken\": \"apns_device_token_optional\",\n    \"deviceInfo\": {\n        \"platform\": \"ios\",\n        \"osVersion\": \"17.0\",\n        \"appVersion\": \"1.0.0\"\n    }\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/google",
							"host": ["{{base_url}}"],
							"path": ["auth", "google"]
						},
						"description": "تسجيل الدخول عبر Google - يرجع JWT token"
					}
				},
				{
					"name": "Apple Sign In",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"identityToken\": \"apple_identity_token_here\",\n    \"authorizationCode\": \"apple_auth_code_here\",\n    \"fullName\": {\n        \"givenName\": \"أحمد\",\n        \"familyName\": \"محمد\"\n    },\n    \"deviceToken\": \"apns_device_token_optional\",\n    \"deviceInfo\": {\n        \"platform\": \"ios\",\n        \"osVersion\": \"17.0\",\n        \"appVersion\": \"1.0.0\"\n    }\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/apple",
							"host": ["{{base_url}}"],
							"path": ["auth", "apple"]
						},
						"description": "تسجيل الدخول عبر Apple - يرجع JWT token"
					}
				},
				{
					"name": "Update Device Token",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"deviceToken\": \"new_apns_device_token\",\n    \"deviceInfo\": {\n        \"platform\": \"ios\",\n        \"osVersion\": \"17.0\",\n        \"appVersion\": \"1.0.0\"\n    }\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/device-token",
							"host": ["{{base_url}}"],
							"path": ["auth", "device-token"]
						},
						"description": "تحديث توكن الإشعارات APNs"
					}
				},
				{
					"name": "Get My Profile",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/auth/me",
							"host": ["{{base_url}}"],
							"path": ["auth", "me"]
						},
						"description": "الحصول على بيانات المستخدم الحالي"
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/auth/logout",
							"host": ["{{base_url}}"],
							"path": ["auth", "logout"]
						},
						"description": "تسجيل الخروج"
					}
				}
			]
		},
		{
			"name": "Users",
			"item": [
				{
					"name": "Search Users",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/mobile/users/search?q=أحمد&page=1&limit=20",
							"host": ["{{base_url}}"],
							"path": ["mobile", "users", "search"],
							"query": [
								{
									"key": "q",
									"value": "أحمد",
									"description": "كلمة البحث"
								},
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "20"
								}
							]
						},
						"description": "البحث عن مستخدمين بالاسم أو البريد"
					}
				}
			]
		},
		{
			"name": "Conversations",
			"item": [
				{
					"name": "Request Conversation",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"recipientId\": \"user_id_here\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/mobile/conversations/request",
							"host": ["{{base_url}}"],
							"path": ["mobile", "conversations", "request"]
						},
						"description": "إرسال طلب محادثة لمستخدم آخر"
					}
				},
				{
					"name": "Get Pending Requests",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/mobile/conversations/pending",
							"host": ["{{base_url}}"],
							"path": ["mobile", "conversations", "pending"]
						},
						"description": "الحصول على طلبات المحادثة المعلقة"
					}
				},
				{
					"name": "Accept Request",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/mobile/conversations/:conversationId/accept",
							"host": ["{{base_url}}"],
							"path": ["mobile", "conversations", ":conversationId", "accept"],
							"variable": [
								{
									"key": "conversationId",
									"value": "conversation_id_here"
								}
							]
						},
						"description": "قبول طلب محادثة"
					}
				},
				{
					"name": "Reject Request",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/mobile/conversations/:conversationId/reject",
							"host": ["{{base_url}}"],
							"path": ["mobile", "conversations", ":conversationId", "reject"],
							"variable": [
								{
									"key": "conversationId",
									"value": "conversation_id_here"
								}
							]
						},
						"description": "رفض طلب محادثة"
					}
				},
				{
					"name": "Get My Conversations",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/mobile/conversations?page=1&limit=20",
							"host": ["{{base_url}}"],
							"path": ["mobile", "conversations"],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "20"
								}
							]
						},
						"description": "الحصول على محادثاتي المقبولة"
					}
				}
			]
		},
		{
			"name": "Messages",
			"item": [
				{
					"name": "Send Message",
					"request": {
						"method": "POST",
						"header": [
