								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "avatar",
									"type": "file",
									"src": ""
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/mobile/profile/avatar",
							"host": ["{{base_url}}"],
							"path": ["mobile", "profile", "avatar"]
