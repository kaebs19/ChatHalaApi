								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"reportedUser\": \"user_id_here\",\n    \"reason\": \"محتوى مسيء\",\n    \"type\": \"inappropriate\",\n    \"details\": \"تفاصيل إضافية عن البلاغ\",\n    \"messageId\": \"message_id_optional\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/mobile/reports",
							"host": ["{{base_url}}"],
							"path": ["mobile", "reports"]
