								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"conversationId\": \"conversation_id_here\",\n    \"content\": \"مرحباً، كيف حالك؟\",\n    \"type\": \"text\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/mobile/messages/send",
							"host": ["{{base_url}}"],
							"path": ["mobile", "messages", "send"]
						},
						"description": "إرسال رسالة في محادثة"
					}
				},
				{
					"name": "Get Messages",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/mobile/messages/:conversationId?page=1&limit=50",
							"host": ["{{base_url}}"],
							"path": ["mobile", "messages", ":conversationId"],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "50"
								}
							],
							"variable": [
								{
									"key": "conversationId",
									"value": "conversation_id_here"
								}
							]
						},
						"description": "الحصول على رسائل محادثة"
					}
				},
				{
					"name": "Mark as Read",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/mobile/messages/:conversationId/read",
							"host": ["{{base_url}}"],
							"path": ["mobile", "messages", ":conversationId", "read"],
							"variable": [
								{
									"key": "conversationId",
									"value": "conversation_id_here"
								}
							]
						},
						"description": "تحديد الرسائل كمقروءة"
					}
				}
			]
		},
		{
			"name": "Reports",
