# Dependencies
node_modules/
*/node_modules/

# Environment variables
.env
.env.local
.env.production
.env.test
# ⚠️ نسخ .env الاحتياطية (.env.save, .env.bak, .env.2026-01-01 …)
# كانت خارج الحجب: أي `git add .` على السيرفر كان يرفع الأسرار للمستودع
.env.*
!.env.example
# نسخ احتياطية لملفات المصدر (api.js.save …)
*.save
*.save.[0-9]
*.bak
*.orig

# Firebase Service Account (SENSITIVE!)
serviceAccount.json
**/serviceAccount.json
backend/config/serviceAccount.json

# APNs Keys
*.p8
AuthKey*.p8

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Build outputs
dist/
# build/ — مرفوع لأن السيرفر لا يستطيع البناء محلياً
*.tsbuildinfo

# Testing
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# Database
*.sqlite
*.db

# Uploads
uploads/
public/uploads/
# استثناء: الصور الجاهزة جزء من التطبيق لا محتوى مستخدمين.
# كانت خارج المستودع فضاعت من الخادم وظهرت 404 لآلاف المستخدمين.
!backend/uploads/
backend/uploads/*
!backend/uploads/defaults/
!backend/uploads/defaults/avatar_*.jpg

# Cache
.cache/
.parcel-cache/

# Package manager
package-lock.json
yarn.lock
pnpm-lock.yaml
